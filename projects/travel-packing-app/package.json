{
  "name": "travel-packing-app",
  "version": "0.1.0",
  "private": true,
  "author": "Jared Fisher <xjaredfisher@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jf1shh/agentic-app-harness.git",
    "directory": "projects/travel-packing-app"
  },
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"const fs=require('fs'); ['dist','.next','.next-prod','.next-capacitor','playwright-report','test-results','tsconfig.tsbuildinfo','.vite'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "build": "npm run clean && next build",
    "build:capacitor": "npm run clean && node -e \"require('child_process').execSync('npx next build',{stdio:'inherit',env:{...process.env,NODE_ENV:'production',CAPACITOR_BUILD:'1',NEXT_BUILD_DIR:'.next-capacitor'}})\"",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@imgly/background-removal": "^1.7.0",
    "idb-keyval": "^6.3.0",
    "next": "16.3.0",
    "onnxruntime-web": "^1.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  }
}
