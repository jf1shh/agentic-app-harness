{
  "name": "smart-recipe-app",
  "version": "0.1.0",
  "private": true,
  "author": "Jared Fisher <xjaredfisher@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jf1shh/agentic-app-harness.git",
    "directory": "projects/smart-recipe-app"
  },
  "scripts": {
    "dev": "next dev",
    "clean": "node -e \"const fs=require('fs'); ['dist','.next','.next-prod','.next-capacitor','playwright-report','test-results','tsconfig.tsbuildinfo','.vite'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "build": "npm run clean && next build",
    "build:capacitor": "npm run clean && node -e \"require('child_process').execSync('npx next build',{stdio:'inherit',env:{...process.env,NODE_ENV:'production',CAPACITOR_BUILD:'1',NEXT_BUILD_DIR:'.next-capacitor'}})\"",
    "start": "next start",
    "lint": "eslint",
    "embed": "node embed-corpus.mjs",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "overrides": {
    "postcss": "8.5.23"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@huggingface/transformers": "4.2.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
