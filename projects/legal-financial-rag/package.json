  "repository": {
    "type": "git",
    "url": "https://github.com/jf1shh/agentic-app-harness.git",
    "directory": "projects/legal-financial-rag"
  },
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3010",
    "clean": "node -e \"const fs=require('fs'); ['dist','.next','playwright-report','test-results','tsconfig.tsbuildinfo','.vite'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "build": "npm run clean && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "eval": "promptfoo eval -c eval/promptfooconfig.yaml --no-cache"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@capacitor/android": "8.5.0",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testing-library/dom": "9.3.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "14.3.1",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "6.0.5",
    "esbuild": "0.25.12",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-security": "2.1.1",
    "jsdom": "24.1.3",
    "promptfoo": "0.121.20",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
