<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy Auto Backup rules (Android 6.0–11, API 23–30; superseded by
  data_extraction_rules.xml on API 31+, but minSdkVersion is 24 so both are
  needed for full coverage).

  Excludes the WebView's own storage directory, where Capacitor's web layer
  keeps localStorage/IndexedDB — including mood_diner_reservations, whose
  free-text "special requests" field can hold sensitive info (allergies,
  health notes) per the privacy policy at public/privacy.html. Without this
  exclusion, Android's automatic cloud backup would copy that data to the
  user's Google account, which the privacy policy promises never happens.
-->
<full-backup-content>
    <exclude domain="file" path="app_webview/" />
</full-backup-content>
