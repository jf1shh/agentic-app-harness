{
  "name": "portfolio-hub",
  "private": true,
  "author": "Jared Fisher <xjaredfisher@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jf1shh/agentic-app-harness.git",
    "directory": "projects/portfolio-hub"
  },
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3009",
    "generate:loop-stats": "node scripts/generate-loop-stats.mjs",
    "clean": "node -e \"const fs=require('fs'); ['dist','.next','playwright-report','test-results','tsconfig.tsbuildinfo','.vite'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "build": "npm run clean && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "lucide-react": "0.544.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-security": "4.0.1",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
