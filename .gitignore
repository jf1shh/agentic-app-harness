node_modules/
dist/
build/
.env*
.DS_Store
*.log
coverage/
.next/
.next-prod/
.next-capacitor/
out/
__pycache__/
*.pyc
venv/
env/
.pytest_cache/

# Generated by the harness sense layer (scripts/harness-status.mjs).
# The derived work orders under tasks/*.md ARE committed; this snapshot is not.
harness-status.json

# Generated by scripts/generate-context-digest.mjs — a point-in-time snapshot
# of per-app spec/schema hashes, module counts, and guardrail/lesson counts.
# Agents compare a saved snapshot against live state to detect context staleness
# during long-running sessions. Regenerable; never a source of truth.
.context-digest.json

# Generated by scripts/emit-github-issues.mjs — an alternate, optional PROPOSE
# output (bulk-importable GitHub issues) derived from harness-status.json.
# Same reasoning as harness-status.json above: a regenerable snapshot, not a
# source of truth. tasks/*.md work orders remain the committed contract.
tasks/issues.json

# TypeScript incremental build cache (.agents/AGENTS.md §5 lists it as a build
# cache to clean, never to commit). Regenerated by every `tsc` run.
tsconfig.tsbuildinfo
**/tsconfig.tsbuildinfo

# Stryker Mutator (scripts/run-mutation.mjs) working/report directories —
# regenerated by every mutation run, never committed. reports/mutation/ holds
# the JSON report; reports/stryker-incremental.json (one level up) is the
# incremental-run cache — both are per-app under projects/<app>/reports/, so
# ignore the whole directory rather than special-casing each file inside it.
**/.stryker-tmp/
**/reports/
stryker.log
**/stryker.log

# repowise (optional MCP exploration aid, see README) — local index/db/cache,
# regenerated per-machine by `repowise init`/`repowise update`. Never commit:
# it embeds a point-in-time snapshot (bug-fix counts, "last fix yesterday",
# etc.) that goes stale immediately, the same reason harness-status.json above
# is gitignored rather than committed.
.repowise/
.claude/CLAUDE.md
