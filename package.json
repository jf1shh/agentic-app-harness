{
  "name": "agentic-app-harness",
  "private": true,
  "description": "Monorepo root — hoists shared dependencies for the apps under projects/*. Each app keeps its own package.json and version ranges; this file adds no dependencies of its own.",
  "author": "Jared Fisher <xjaredfisher@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jf1shh/agentic-app-harness.git"
  },
  "workspaces": [
    "projects/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1",
    "fast-uri": "^3.1.7",
    "xcode": {
      "uuid": "^11.1.1"
    },
    "next": "16.3.8",
    "vitest": "4.1.11",
    "axios": "^1.20.0",
    "js-yaml@5.2.2": "^5.4.1"
  },
  "devDependencies": {
    "onnxruntime-web": "^1.27.0"
  }
}
